# ============================================================================
# .htaccess — Apache / cPanel / DirectAdmin
# Dùng khi deploy bản build tĩnh (thư mục dist) lên hosting chạy Apache.
# Nếu deploy trên Vercel/Nginx thì file này không có tác dụng (bỏ qua an toàn).
# ============================================================================

# ------------------------------- ÉP HTTPS -----------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Chuyển toàn bộ http -> https
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SPA Rewrite: mọi đường dẫn không phải file/thư mục thật -> index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------- GZIP / NÉN ---------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
</IfModule>

# --------------------------- BROWSER CACHING --------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Tài nguyên tĩnh có hash -> cache 1 năm
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  # HTML luôn tươi để cập nhật nội dung
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ------------------------- SECURITY HEADERS -------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
</IfModule>

# ------------------------------ CHẶN TRUY CẬP -------------------------------
# Không cho lộ file cấu hình nhạy cảm nếu vô tình upload
<FilesMatch "(^\.|\.(env|log|bak|config\.js)$)">
  Require all denied
</FilesMatch>
